# Copy to .env — never commit the real file.

DJANGO_SECRET_KEY=change-me-to-something-long-and-random
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://chalani.example.com

# Uploads live outside the repo. Back this up together with the database.
CHALAANI_MEDIA_ROOT=~/.chalaani/media
# DJANGO_DB_PATH=/var/lib/chalaani/db.sqlite3

# AI reading of chalani photos
ANTHROPIC_API_KEY=
CHALAANI_EXTRACTION_MODEL=claude-opus-5
CHALAANI_EXTRACTION_EFFORT=medium
CHALAANI_EXTRACTION_ENABLED=1

# Background jobs: 0 = a separate `manage.py qcluster` process does the work,
# 1 = run extraction inline in the request (fine for a demo, blocks the upload).
Q_SYNC=0
Q_WORKERS=2

# 1 = Tailwind + daisyUI from the CDN (no build step)
# 0 = serve static/css/build.css produced by the Tailwind standalone binary
CHALAANI_TAILWIND_CDN=1
